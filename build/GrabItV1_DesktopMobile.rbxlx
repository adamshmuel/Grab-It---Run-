		<Item class="ModuleScript" referent="RBX1adb4b7f023347379b138d189078d6c2">
				<Properties>
					<string name="Name">StorageMode</string>
					<string name="Source">--!strict
local Mode = {}
export type Selection = { memory: boolean, name: string?, keyPrefix: string }

function Mode.select(isStudio: boolean, runId: any): Selection
	if not isStudio then
		return { memory = false, name = "GrabItV1_PlayerData", keyPrefix = "" }
	end
	if type(runId) == "string" and #runId &gt; 0 and #runId &lt;= 20 and runId:match("^[%w_%-]+$") then
		return {
			memory = false,
			name = "GrabItV1_QA_Verification",
			keyPrefix = "QA_" .. runId .. "_",
		}
	end
	return { memory = true, keyPrefix = "" }
end

return Mode
</string>
				</Properties>
			</Item>
		</Item>
	</Item>
