				</Item>
				<Item class="ModuleScript" referent="RBX292df274801848448cdbe417e07e5ded">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
local ItemVisibility = {}
function ItemVisibility.set(item: BasePart, hidden: boolean)
	item.LocalTransparencyModifier = if hidden then 1 else 0
	for _, child in item:GetDescendants() do
		if child:IsA("BasePart") then
			child.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
	local label = item:FindFirstChild("ValueLabel")
	if label and label:IsA("BillboardGui") then
		label.Enabled = not hidden
	end
end
return table.freeze(ItemVisibility)
]]></ProtectedString>
						<string name="ScriptGuid">{73f38881-6113-4b21-974e-a84e90928571}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">ItemVisibility</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">38891aa5b601d1530aecfb3f00000b66</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXb52f4e7afdbf4be8a39deae1c00c51eb">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
local Ui = require(script.Parent.Ui)
local Results = require(script.Parent.Results)
local Scores = {}

function Scores.create(parent: Instance)
	local panel = Ui.panel(parent, "LiveScores")
	local title = Ui.label(panel, "Title", UDim2.new(), UDim2.new(1, 0, 0, 22), "LIVE RESULTS")
	local grid = Results.table(panel)
	local close =
		Ui.label(panel, "Close", UDim2.new(0.78, 0, 0, 6), UDim2.new(0.22, 0, 0, 48), "Close", true)
	local ui = {
		Panel = panel,
		Title = title,
		Container = grid.Container,
		Header = grid.Header,
		Rows = grid.Rows,
		Close = close,
		available = false,
	}
	ui.connection = close.Activated:Connect(function()
		panel.Visible = false
	end)
	return ui
end

function Scores.toggle(ui)
	ui.Panel.Visible = ui.available and not ui.Panel.Visible
end

function Scores.update(ui, state, localId: string)
	ui.available = state.ready and state.phase == "active"
	if not ui.available then
		ui.Panel.Visible = false
	end
	local compact = ui.Panel.AbsoluteSize.Y < 350
	ui.Container.Position = UDim2.fromScale(if compact then 0.18 else 0, 0)
	ui.Container.Size = UDim2.fromScale(if compact then 0.82 else 1, 1)
	ui.Title.Position = ui.Container.Position
	ui.Title.Size = UDim2.new(if compact then 0.82 else 1, 0, 0, 22)
	ui.Close.Position = if compact then UDim2.fromOffset(0, 6) else UDim2.new(0.78, 0, 1, -48)
	ui.Close.Size = UDim2.new(if compact then 0.16 else 0.22, 0, 0, 48)
	local seconds = math.max(0, state.remaining)
	ui.Title.Text = string.format(
		"LIVE RESULTS | %d / 3 | %d:%02d",
		state.stage,
		math.floor(seconds / 60),
		seconds % 60
	)
	Results.fill(ui, state.rows or {}, localId, false)
end

function Scores.destroy(ui)
	ui.connection:Disconnect()
	ui.Panel:Destroy()
end

return Scores
]]></ProtectedString>
						<string name="ScriptGuid">{ae5809e3-8d42-4586-9c62-0cfbe3d3fcb4}</string>
