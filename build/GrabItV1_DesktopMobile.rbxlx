					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">server</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">38891aa5b601d1530aecfb3f00000978</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXc5f8256e55334e23900b026ecd7f65d8">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
return function(players: number, duration: number, collectionOnly: boolean?, loopSmoke: boolean?)
	assert(game:GetService("RunService"):IsStudio(), "Studio-only QA")
	assert(not game:GetService("RunService"):IsRunning(), "launch from Edit")
	assert(
		game.PlaceId == 0 and game:GetService("ReplicatedStorage"):FindFirstChild("GrabIt"),
		"verify project first"
	)
	assert(
		players >= 1 and players <= 8 and duration >= 0 and duration <= 900,
		"bounded QA settings"
	)
	local server = game:GetService("ServerScriptService")
	local client = game:GetService("StarterPlayer").StarterPlayerScripts
	assert(
		not server:FindFirstChild("GrabItQA_Server")
			and not client:FindFirstChild("GrabItQA_Client"),
		"QA already attached"
	)
	local templates = game:GetService("ServerStorage").GrabItQA
	local serverRunner = templates.server:Clone()
	serverRunner.Name = "GrabItQA_Server"
	serverRunner.Parent = server
	local clientRunner = templates.client:Clone()
	clientRunner.Name = "GrabItQA_Client"
	clientRunner.Parent = client
	local storage = game:GetService("ReplicatedStorage")
	local previousClaim = storage:GetAttribute("JestRobloxRunClaimed")
	-- The installed Jest runner explicitly defers to an existing run claim.
	-- Coordinate this test without changing the plugin or enabling LoadString.
	storage:SetAttribute("JestRobloxRunClaimed", "GrabItV1.AutomatedQA")
	game:SetAttribute("GrabItQAResult", nil)
	task.spawn(function()
		local ok, result = pcall(function()
			local args = {
				marker = "GrabItV1.AutomatedQA",
				players = players,
				duration = duration,
				collectionOnly = collectionOnly == true,
				loopSmoke = loopSmoke == true,
			}
			local service = game:GetService("StudioTestService")
			return service:ExecuteMultiplayerTestAsync(players, args)
		end)
		serverRunner:Destroy()
		clientRunner:Destroy()
		storage:SetAttribute("JestRobloxRunClaimed", previousClaim)
		game:SetAttribute(
			"GrabItQAResult",
			game:GetService("HttpService"):JSONEncode({
				ok = ok,
				players = players,
				duration = duration,
				collectionOnly = collectionOnly == true,
				result = result,
			})
		)
	end)
	return "Started bounded QA; read the GrabItQAResult project attribute after completion"
end
]]></ProtectedString>
					<string name="ScriptGuid">{199b078a-54b4-46fd-8aa6-6a3e5a4d0d3c}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">launch</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">38891aa5b601d1530aecfb3f00000979</UniqueId>
				</Properties>
			</Item>
		<Item class="ModuleScript" referent="RBX30d6d654b00c4880b995cb2ef8b9fef9">
				<Properties>
					<string name="Name">cloud-check</string>
					<string name="Source">--!strict
return function(runId: string, userId: number, coins: number, tutorial: boolean, locked: boolean)
	assert(game:GetService("RunService"):IsStudio(), "cloud QA verification is Studio-only")
	assert(
		#runId &gt; 0 and #runId &lt;= 20 and runId:match("^[%w_%-]+$"),
		"valid isolated QA run required"
	)
	local key = "QA_" .. runId .. "_User_" .. userId
	local store = game:GetService("DataStoreService")
		:GetDataStore("GrabItV1_QA_Verification", "global")
	local options = Instance.new("DataStoreGetOptions")
	options.UseCache = false
	local record = store:GetAsync(key, options)
	assert(record, "cloud QA record is missing from global scope")
	assert(record.version == 1, "cloud record uses the current schema")
	assert(
		record.coins == coins and record.tutorial == tutorial,
		"cloud progress matches confirmed game state"
	)
	assert((record.owner ~= nil) == locked, "cloud session lock matches lifecycle")
	return {
		key = key,
		coins = record.coins,
		tutorial = record.tutorial,
		locked = locked,
