					<UniqueId name="UniqueId">09d7294fd6590db50afde54b000015ab</UniqueId>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX4adb79e7606c4e779feb163784a03161">
			<Properties>
				<Color3 name="IconTint">
					<R>0</R>
					<G>0</G>
					<B>0</B>
				</Color3>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">GrabItQA</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">38891aa5b601d1530aecfb3f00000976</UniqueId>
			</Properties>
			<Item class="LocalScript" referent="RBXde1adbf1ac8d424d930d6eb975744b6e">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
	return
end
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local root = game:GetService("ReplicatedStorage"):WaitForChild("GrabIt", 20)
local channel = game:GetService("ReplicatedStorage"):WaitForChild("GrabItQAChannel", 20)
assert(root and channel, "QA replication timed out")
local View = require(root.Shared.Presentation)
local Wire = require(root.Shared.NetworkState)
local Catalog = require(root.Shared.Catalog)
assert(channel:GetAttribute("Marker") == "GrabItV1.ImprovementsQA", "wrong QA channel")
local duration = channel:GetAttribute("Duration")
local qualitySettings = UserSettings():GetService("UserGameSettings")
script:SetAttribute("Stage", "loading")
local state = nil
local snapshots = {}
local lastAttempt = nil
local joining = nil
local stateConnection = root.State.OnClientEvent:Connect(function(value)
	value.collected = Wire.unpackCollected(value.collected)
	state = value
	table.insert(snapshots, {
		target = value.target,
		cargo = value.cargoCount,
		coins = value.coins,
		round = value.roundId,
		remaining = value.remaining,
		collected = Wire.packCollected(value.collected),
	})
	if #snapshots > 12 then
		table.remove(snapshots, 1)
	end
end)
local frames, slowFrames, seconds = 0, 0, 0
local windowSeconds, windowFrames, sampleCount, slowSamples = 0, 0, 0, 0
local minimumFPS = nil
local sampling = false
local measuring = channel:GetAttribute("MeasureFrames") ~= false
local measurementConnection = channel:GetAttributeChangedSignal("MeasureFrames"):Connect(function()
	measuring = channel:GetAttribute("MeasureFrames") == true
	if measuring then
		frames, slowFrames, seconds = 0, 0, 0
		windowSeconds, windowFrames, sampleCount, slowSamples = 0, 0, 0, 0
		minimumFPS = nil
	end
end)
local frameConnection = RunService.RenderStepped:Connect(function(dt)
	if sampling and measuring and seconds < 600 then
		frames += 1
		seconds += dt
		if dt > 1 / 30 then
			slowFrames += 1
		end
		windowSeconds += dt
		windowFrames += 1
		if windowSeconds >= 1 then
			local fps = windowFrames / windowSeconds
			sampleCount += 1
			if fps < 30 then
				slowSamples += 1
			end
			minimumFPS = math.min(minimumFPS or fps, fps)
			windowSeconds, windowFrames = 0, 0
		end
	end
end)
local function awaitCondition(check, timeout: number, message: string)
	local deadline = os.clock() + timeout
	repeat
		if check() then
			return
		end
		task.wait(0.1)
	until os.clock() >= deadline
	error(message)
end
local function walk(x: number, z: number, tolerance: number?)
	local character = player.Character
	assert(character, "missing character")
	local center = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	assert(center and humanoid, "missing humanoid")
	local deadline = os.clock() + 18
	repeat
		if
			(Vector3.new(x, center.Position.Y, z) - center.Position).Magnitude < (tolerance or 2)
		then
			return
		end
		humanoid:MoveTo(Vector3.new(x, center.Position.Y, z))
		task.wait(0.15)
	until os.clock() >= deadline
	error("walking timed out: " .. x .. "," .. z)
end
local function collect(expected: number, optional: boolean?)
	task.wait(0.25)
	local function target()
		local character = player.Character
		local center = if character then character:FindFirstChild("HumanoidRootPart") else nil
		return if center
			then View.collectionTarget(
				Catalog.items(state.stage, state.layout),
				state,
				center.Position
			)
			else nil
	end
	if optional and not target() then
		return
	end
	awaitCondition(function()
		return state and target() ~= nil
	end, 3, "no collectible target")
	lastAttempt = {
		target = target(),
		cargo = state.cargoCount,
		coins = state.coins,
		round = state.roundId,
		remaining = state.remaining,
		collected = Wire.packCollected(state.collected),
		position = tostring(player.Character:GetPivot().Position),
	}
	root.Action:FireServer("collect", target())
	awaitCondition(function()
		return state.cargoCount == expected
	end, 4, "collection was not accepted")
end
local leaveConnection = channel.OnClientEvent:Connect(function(action)
	if action == "verify-after-leave" then
		local ui = player.PlayerGui:FindFirstChild("GrabItHUD")
		local coins = if ui then tonumber(string.match(ui.Root.Coins.Text, "%d+")) else nil
		channel:FireServer({
			stage = "after-leave",
			passed = state and coins == state.coins,
			coins = coins,
		})
	end
end)
local ok, result = pcall(function()
	for _ = 1, 30 do
		root.Action:FireServer("ready")
		if state and state.ready then
			break
		end
		task.wait(0.5)
	end
	assert(
		state and state.ready and state.coins == 0 and state.cargoCount == 0,
		"fresh player defaults"
	)
	awaitCondition(function()
		return player.Character
			and player.Character:FindFirstChild("HumanoidRootPart")
			and player.Character:FindFirstChildOfClass("Humanoid")
	end, 15, "character did not finish loading")
	if channel:GetAttribute("Staggered") then
		awaitCondition(function()
			return state.open
		end, 10, "first solo stage did not open")
		channel:FireServer({
			stage = "started-active",
			round = state.roundId,
			remaining = state.remaining,
		})
		awaitCondition(function()
			return channel:GetAttribute("OriginalPlayer") ~= nil
		end, 5, "staggered identity missing")
		local original = player.UserId == channel:GetAttribute("OriginalPlayer")
		local ownRow = nil
		for _, row in state.rows do
			if row.id == tostring(player.UserId) then
				ownRow = row
			end
		end
		assert(
			state.mode == "solo"
				and state.stage == 1
				and state.roundId == channel:GetAttribute("OriginalRound"),
			"join cannot reset active solo stage"
		)
		assert(
			ownRow and ownRow.ranked == original,
			"late joiners remain Unranked until next stage"
		)
		assert(
			state.remaining <= channel:GetAttribute("OriginalRemaining"),
			"join cannot extend clock"
		)
		joining = {
			original = original,
			mode = state.mode,
			remaining = state.remaining,
			ranked = ownRow.ranked,
		}
	end
	local encodedRoutes = channel:GetAttribute("RoutePlan")
	if encodedRoutes then
		return require(channel:WaitForChild("routes"))(encodedRoutes, duration, {
			root = root,
			player = player,
			getState = function()
				return state
			end,
			walk = walk,
			collect = collect,
			awaitCondition = awaitCondition,
			runner = script,
		})
	end
	local began = os.clock()
	sampling = true
	script:SetAttribute("Stage", "first-trip")
	walk(0, 8)
	local smoke = channel:GetAttribute("LoopSmoke") == true
	local firstTrip = if smoke
		then { { -12, 12 } }
		else {
			{ -12, 12 },
			{ -12, 18 },
			{ -12, 24 },
			{ -12, 30 },
			{ 12, 30 },
			{ 12, 24 },
			{ 12, 18 },
			{ 12, 12 },
		}
	local initialCount = #firstTrip
	local expectedWeight = if smoke then 1 else 10
	local expectedCoins = if smoke then 2 else 18
	for index, point in firstTrip do
		walk(point[1], point[2])
		collect(index)
	end
	assert(tonumber(state.cargoValue) == expectedCoins, "catalog cargo reward")
	assert(tonumber(state.cargoWeight) == expectedWeight, "weight capacity supports eight items")
	assert(
		math.abs(player.Character.Humanoid.WalkSpeed - 16 * (1 - 0.35 * expectedWeight / 10)) < 0.01,
		"cargo slows by weight, not item count"
	)
	script:SetAttribute("Stage", "full-cargo")
	task.wait(8)
	if channel:GetAttribute("CollectionOnly") then
		return { cargo = state.cargoCount, cargoValue = state.cargoValue, collectionOnly = true }
	end
	root.Action:FireServer("collect", 1)
	task.wait(0.4)
	assert(state.cargoCount == initialCount, "repeated item does not duplicate cargo")
	walk(0, 8)
	walk(0, -8)
	awaitCondition(function()
		return state.coins == expectedCoins and state.cargoCount == 0 and state.tutorial
	end, 4, "first deposit")
	script:SetAttribute("Stage", "first-bank")
	if not channel:GetAttribute("LoopSmoke") then
		walk(0, 8)
		walk(12, 36)
		collect(1)
		script:SetAttribute("Stage", "waiting-for-closure")
		awaitCondition(function()
			return not state.open
		end, 190, "warehouse did not close")
		awaitCondition(function()
			return player.Character.HumanoidRootPart.Position.Z < 0 and state.cargoCount == 0
		end, 4, "closure did not return player and clear cargo")
		assert(state.coins == expectedCoins, "closure preserves banked progress")
		script:SetAttribute("Stage", "closed")
		awaitCondition(function()
			return state.open
		end, 25, "next round did not open")
		walk(0, 8)
		walk(-12, 12)
		collect(1)
		walk(0, 8)
		walk(0, -8)
		awaitCondition(function()
			return state.coins == expectedCoins + 3 and state.cargoCount == 0
		end, 4, "next round refresh and second deposit")
		if joining then
			awaitCondition(
				function()
					if
						state.mode ~= "multi"
						or #state.rows ~= channel:GetAttribute("ExpectedPlayers")
					then
						return false
					end
					for _, row in state.rows do
						if not row.ranked or row.score ~= 3 or row.place ~= 1 then
							return false
						end
					end
					return true
				end,
				12,
				"next stage must recount multiplayer, rank every ready player and share tied place"
			)
		end
	end
	script:SetAttribute("Stage", "load-loop")
	while os.clock() - began < duration or (duration >= 600 and seconds < 600) do
		if state.open and state.remaining > 35 then
			local nextItem = nil
			for _, item in Catalog.items(state.stage, state.layout) do
				if not state.collected[item.id] then
					nextItem = item
					break
				end
			end
			if nextItem then
				walk(0, 8)
				walk(nextItem.x, nextItem.z)
				collect(1, true)
				walk(0, 8)
				walk(0, -8)
				awaitCondition(function()
					return state.cargoCount == 0
				end, 4, "load-loop deposit was not confirmed")
			else
				task.wait(0.5)
			end
		else
			task.wait(0.5)
		end
	end
	if duration >= 600 then
		assert(measuring and seconds >= 600, "ten-minute measurement window was not completed")
	end
	sampling = false
	return {
		coins = state.coins,
		cargo = state.cargoCount,
		stage = state.stage,
		joining = joining,
		mode = state.mode,
		rows = state.rows,
		frames = frames,
		slowFrames = slowFrames,
		sampleSeconds = seconds,
		sampleCount = sampleCount,
		slowSamples = slowSamples,
		minimumFPS = minimumFPS,
		viewport = tostring(workspace.CurrentCamera.ViewportSize),
		touch = game:GetService("UserInputService").TouchEnabled,
		quality = tostring(qualitySettings.SavedQualityLevel),
		input = "Humanoid MoveTo and real client RemoteEvent requests",
	}
end)
sampling = false
stateConnection:Disconnect()
frameConnection:Disconnect()
measurementConnection:Disconnect()
script:SetAttribute("Stage", if ok then "completed" else "failed")
script:SetAttribute("Passed", ok)
script:SetAttribute("Result", if ok then "completed" else tostring(result))
channel:FireServer({
	passed = ok,
	result = if ok
		then result
		else {
			error = tostring(result),
			cargo = state and state.cargoCount,
			target = state and state.target,
			position = player.Character and tostring(player.Character:GetPivot().Position),
			lastAttempt = lastAttempt,
			snapshots = snapshots,
			joining = joining,
			frames = frames,
			sampleSeconds = seconds,
			viewport = tostring(workspace.CurrentCamera.ViewportSize),
			quality = tostring(qualitySettings.SavedQualityLevel),
			routeJournal = script:GetAttribute("RouteJournal"),
		},
})
if not ok or channel:GetAttribute("CollectionOnly") then
	leaveConnection:Disconnect()
end
]]></ProtectedString>
