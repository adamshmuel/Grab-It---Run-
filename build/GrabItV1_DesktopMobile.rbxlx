				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6974e6ff068249d18bd8dbc49da96e95">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
return function()
	local source = game:GetService("ServerScriptService").GrabItModules
		:FindFirstChild("StorageMode")
	assert(source, "storage selection needs an isolated cloud QA mode")
	local copy = source:Clone()
	local ok, result = pcall(function()
		local Mode = require(copy)
		local live = Mode.select(false, "qa_cloud_01")
		assert(
			not live.memory and live.name == "GrabItV1_PlayerData" and live.keyPrefix == "",
			"live storage ignores QA markers"
		)
		local normal = Mode.select(true, nil)
		assert(
			normal.memory and normal.name == nil and normal.keyPrefix == "",
			"ordinary Studio stays isolated"
		)
		local qa = Mode.select(true, "qa_cloud_01")
		assert(
			not qa.memory and qa.name == "GrabItV1_QA_Verification",
			"cloud QA has a fixed separate store"
		)
		assert(qa.keyPrefix == "QA_qa_cloud_01_", "cloud QA keys belong to one explicit run")
		for _, value in { false, 10, {}, "", "../production", string.rep("x", 21) } do
			assert(Mode.select(true, value).memory, "invalid QA markers cannot enable cloud writes")
		end
		local longest = Mode.select(true, string.rep("x", 20))
		assert(
			#(longest.keyPrefix .. "User_" .. string.rep("9", 20)) <= 50,
			"run prefix fits the datastore key limit"
		)
		local args = { marker = "GrabItV1.IsolatedCloudQA", runId = "qa_runtime_01" }
		local runtime = Mode.select(true, nil, args)
		assert(
			not runtime.memory
				and runtime.name == "GrabItV1_QA_Verification"
				and runtime.keyPrefix == "QA_qa_runtime_01_",
			"native test args must opt into the same isolated QA store"
		)
		assert(
			Mode.select(false, nil, args).name == "GrabItV1_PlayerData",
			"live servers ignore native QA args"
		)
		assert(
			Mode.select(true, "attribute", args).keyPrefix == "QA_attribute_",
			"explicit attribute has priority"
		)
		assert(Mode.select(true, false, args).memory, "invalid explicit marker fails closed")
		for _, bad in
			{
				{},
				false,
				"qa_runtime_01",
				{ marker = "other", runId = "qa_runtime_01" },
				{ marker = args.marker, runId = "../production" },
				{ marker = args.marker, runId = string.rep("x", 21) },
			}
		do
			assert(
				Mode.select(true, nil, bad).memory,
				"unknown or malformed native args stay memory-only"
			)
		end
		return 8
	end)
	copy:Destroy()
	assert(ok, result)
	return result
end
]]></ProtectedString>
					<string name="ScriptGuid">{d0b35bc1-193f-4c62-9a9a-90ef07579a83}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">StorageMode.spec</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">757135cc0250e8ce0af0ee8f000003df</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX03b44c4f455b41a7acfeeced4b6c3f4c">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
return function(): number
	local shared = game:GetService("ReplicatedStorage").GrabIt.Shared:Clone()
	local ok, result = pcall(function()
		local P = require(shared.Persistence)
		local records = {}
		local now = 10
		local drop = false
		local broken = false
		local function update(key, transform)
			if broken then
				error("outage")
			end
			local value = transform(records[key])
			if value then
				records[key] = value
			end
			if drop then
				drop = false
				error("response lost AFTER commit")
			end
			return value
		end
		local a = P.new(update, "a", function()
			return now
		end)
		local b = P.new(update, "b", function()
			return now
		end)
		local fresh = a:load("new")
		assert(
			fresh and fresh.version == 2 and fresh.owned.basic and fresh.selected == "basic",
			"RED: versioned cosmetic record missing"
		)
		assert(b:load("new") == nil, 'ImprovementPersistence.spec: b:load("new") == nil')
		for _, coins in { 0, 29, 30, 99, 100, 299, 300 } do
			local key = "legacy" .. coins
			records[key] = { version = 1, coins = coins, tutorial = true }
			local d = a:load(key)
			assert(
				d and d.coins == coins and d.tutorial,
				"ImprovementPersistence.spec: d and d.coins == coins and d.tutorial"
			)
			assert(
				(d.owned.canvas == true) == (coins >= 30),
				"ImprovementPersistence.spec: (d.owned.canvas == true) == (coins >= 30)"
			)
			assert(
				(d.owned.field == true) == (coins >= 100),
				"ImprovementPersistence.spec: (d.owned.field == true) == (coins >= 100)"
			)
			assert(
				(d.owned.royal == true) == (coins >= 300),
				"ImprovementPersistence.spec: (d.owned.royal == true) == (coins >= 300)"
			)
		end
		assert(
			a:saveProfile("new", {
				coins = 120,
				tutorial = true,
				owned = { basic = true },
				selected = "basic",
				revision = 1,
			}),
			'ImprovementPersistence.spec: a:saveProfile( "new", { coins = 120, tutorial = true, owned = { basic = true }, selected = "basic", '
		)
		local snapshot = {
			coins = 120,
			tutorial = true,
			owned = { basic = true },
			selected = "basic",
			revision = 1,
		}
		drop = true
		local status = a:purchase("new", "canvas", snapshot, "purchase-1")
		assert(
			status == "pending" and records.new.coins == 20 and records.new.owned.canvas,
			'ImprovementPersistence.spec: status == "pending" and records.new.coins == 20 and records.new.owned.canvas'
		)
		local status2, confirmed = a:purchase("new", "canvas", snapshot, "purchase-1")
		assert(
			status2 == "confirmed" and confirmed.coins == 20,
			'ImprovementPersistence.spec: status2 == "confirmed" and confirmed.coins == 20'
		)
		assert(
			a:saveProfile("new", {
				coins = 40,
				tutorial = true,
				owned = { basic = true, canvas = true },
				selected = "canvas",
				revision = 3,
			}),
			'ImprovementPersistence.spec: a:saveProfile("new", { coins = 40, tutorial = true, owned = { basic = true, canvas = true }, selecte'
		)
		assert(
			not a:saveProfile("new", snapshot) and records.new.coins == 40,
			"stale pre-purchase snapshot cannot restore balance"
		)
		local again = a:purchase("new", "canvas", {
			coins = 40,
			tutorial = true,
			owned = { basic = true, canvas = true },
			selected = "canvas",
			revision = 3,
		}, "purchase-2")
		assert(
			again == "owned" and records.new.coins == 40,
			'ImprovementPersistence.spec: again == "owned" and records.new.coins == 40'
		)
		assert(
			a:purchase("new", "royal", {
				coins = 40,
				tutorial = true,
				owned = { basic = true, canvas = true },
				selected = "canvas",
				revision = 3,
			}, "purchase-3") == "insufficient",
			'ImprovementPersistence.spec: a:purchase("new", "royal", { coins = 40, tutorial = true, owned = { basic = true, canvas = true }, s'
		)
		broken = true
		assert(
			a:load("missing") == nil and records.missing == nil,
			'ImprovementPersistence.spec: a:load("missing") == nil and records.missing == nil'
		)
		broken = false
		assert(
			a:releaseProfile("new", {
				coins = 40,
				tutorial = true,
				owned = { basic = true, canvas = true },
				selected = "canvas",
				revision = 3,
			}),
			'ImprovementPersistence.spec: a:releaseProfile("new", { coins = 40, tutorial = true, owned = { basic = true, canvas = true }, sele'
		)
		local restored = b:load("new")
		assert(
			restored.coins == 40 and restored.selected == "canvas" and restored.owned.canvas,
			'ImprovementPersistence.spec: restored.coins == 40 and restored.selected == "canvas" and restored.owned.canvas'
		)
		assert(
			not a:saveProfile("new", snapshot),
			'ImprovementPersistence.spec: not a:saveProfile("new", snapshot)'
		)
		records.lease = { version = 1, coins = 120, tutorial = false }
		local lease = a:load("lease")
		drop = true
		assert(
			a:purchase("lease", "canvas", lease, "unknown-lease") == "pending",
			"response dropped after committed purchase"
		)
		now += 121
		assert(b:load("lease"), "new session after lease expiry")
		assert(
			a:purchase("lease", "canvas", lease, "unknown-lease") == "pending",
			"lost lease cannot prove an unknown purchase failed"
		)
		records.infinite =
			{ version = 1, coins = 1, tutorial = false, owner = "bad", expires = math.huge }
		assert(a:load("infinite") == nil, "non-finite lease fails closed")
		local profileModule = shared:FindFirstChild("Profile")
		assert(profileModule, "RED: concurrent purchase reconciliation must be testable")
		local Profile = require(profileModule)
		local player = {
			coins = 120,
			tutorial = true,
			owned = { basic = true },
			selected = "basic",
			revision = 1,
			stageScore = 50,
			runEarnings = 80,
		}
		local before = Profile.capture(player)
		player.coins += 20
		player.revision += 1
		player.stageScore += 20
		player.runEarnings += 20
		assert(
			Profile.confirmPurchase(player, before, {
				coins = 20,
				owned = { basic = true, canvas = true },
				selected = "basic",
				tutorial = true,
				revision = 2,
			}),
			"deposit during purchase requires another save"
		)
		assert(
			player.coins == 40
				and player.owned.canvas
				and player.selected == "basic"
				and player.revision == 3,
			"merge debit without losing concurrent deposit or auto-equipping"
		)
		assert(
			player.stageScore == 70 and player.runEarnings == 100,
			"purchase cannot change earned competitive score"
		)
		for _, style in require(shared.Cosmetics).list do
			if style.price == 0 then
				continue
			end
			local key = "exact-" .. style.id
			assert(a:load(key), "new isolated purchase profile")
			local funded = {
				coins = style.price,
				tutorial = true,
				owned = { basic = true },
				selected = "basic",
				revision = 1,
			}
			assert(a:saveProfile(key, funded), "fund exact price in fake backend")
			local exactStatus, bought = a:purchase(key, style.id, funded, "exact-purchase")
			assert(
				exactStatus == "confirmed" and bought.coins == 0 and bought.owned[style.id],
				"exact purchase persists debit and ownership together"
			)
			local repeated, same = a:purchase(key, style.id, funded, "exact-purchase")
			assert(
				repeated == "confirmed" and same.coins == 0,
				"repeated transaction does not charge twice"
			)
			assert(
				not a:saveProfile(key, funded),
				"old funded snapshot cannot restore spent balance"
			)
			assert(a:releaseProfile(key, bought), "release exact purchase")
			local rejoined = b:load(key)
			assert(
				rejoined and rejoined.coins == 0 and rejoined.owned[style.id],
				"zero balance and ownership survive new session"
			)
		end
		records.corruptTransaction = {
			version = 2,
			coins = 100,
			tutorial = false,
			owned = { basic = true },
			selected = "basic",
			revision = 0,
			lastTransaction = true,
		}
		assert(a:load("corruptTransaction") == nil, "invalid transaction metadata fails closed")
		return 24
	end)
	shared:Destroy()
	assert(ok, result)
	return result
end
]]></ProtectedString>
					<string name="ScriptGuid">{d8b80c57-e6c7-49cc-a576-43e7e1d62feb}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ImprovementPersistence.spec</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">757135cc0250e8ce0af0ee8f000009bb</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXda21050819df49db822c52aba72f14be">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
return function(): number
	local p = assert(game.Players.LocalPlayer, "StylesLayout requires a client")
	local clone = game.ReplicatedStorage.GrabIt:Clone()
	local H = require(clone.ClientModules.Hud)
	local S = require(clone.ClientModules.Styles)
	local ui = H.create()
	ui.Screen.Parent = p.PlayerGui
	ui.Root.Size = UDim2.fromOffset(706, 281)
	local requests = {}
	local collection = S.create(ui.Root, function(action, id)
		table.insert(requests, { action, id })
	end)
	collection.Panel.Visible = true
	local ok, err = pcall(function()
		task.wait()
		S.update(collection, {
			ready = true,
			inBase = true,
			open = true,
			owned = { basic = true },
			selected = "basic",
			coins = 62,
			purchase = "",
		})
		task.wait()
		local button = collection.Cards[1].Button
		assert(
			button.AbsolutePosition.X >= ui.Root.AbsolutePosition.X + ui.Root.AbsoluteSize.X * 0.2,
			"Style actions must leave the mobile joystick region clear"
		)
		for _, card in collection.Cards do
			assert(card.Button.AbsoluteSize.Y >= 48, "Style actions keep a 48px touch target")
			assert(
				card.Button.Parent:FindFirstChild("Name").TextFits,
				"Design names remain readable"
			)
		end
		ui.Root.Size = UDim2.fromOffset(923, 592)
		S.update(collection, {
			ready = true,
			inBase = true,
			open = true,
			owned = { basic = true },
			selected = "basic",
			coins = 62,
			purchase = "",
		})
		task.wait()
		for _, card in collection.Cards do
			local preview = card.Preview
			local camera = assert(preview.CurrentCamera, "Equipment preview needs a camera")
			local halfHeight = math.tan(math.rad(camera.FieldOfView / 2))
			local halfWidth = halfHeight * preview.AbsoluteSize.X / preview.AbsoluteSize.Y
			local model =
				assert(preview:FindFirstChildWhichIsA("Model"), "Equipment preview needs its model")
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					for _, x in { -1, 1 } do
						for _, y in { -1, 1 } do
							for _, z in { -1, 1 } do
								local corner = part.CFrame:PointToWorldSpace(
									part.Size * Vector3.new(x, y, z) / 2
								)
								local point = camera.CFrame:PointToObjectSpace(corner)
								assert(
									point.Z < 0
										and math.abs(point.X) < -point.Z * halfWidth * 0.96
										and math.abs(point.Y) < -point.Z * halfHeight * 0.96,
									"Every equipment part must fit inside its preview with margin, including wide cases"
								)
							end
						end
					end
				end
			end
		end
		local owned: { [string]: boolean } = { basic = true }
		local state = {
			ready = true,
			inBase = true,
			open = true,
			owned = owned,
			selected = "basic",
			coins = 99,
			purchase = "",
		}
		S.update(collection, state)
		collection.Panel.Visible = true
		S.activate(collection, "canvas")
		assert(
			collection.Status.Text == "Not enough Coins.",
			"Insufficient Coins has a simple visible message"
		)
		assert(#requests == 0, "Rejected purchases do not send buy or equip requests")
		S.update(collection, state)
		assert(
			collection.Status.Text == "Not enough Coins.",
			"State updates must not erase the message"
		)
		state.coins = 100
		S.update(collection, state)
		assert(
			collection.Status.Text == "" and #requests == 0,
			"New funds clear the error without buying"
		)
		S.activate(collection, "canvas")
		assert(
			#requests == 1 and requests[1][1] == "buy" and requests[1][2] == "canvas",
			"Exact funds request one purchase"
		)
		state.purchase = "Purchase pending"
		state.coins = 0
		S.update(collection, state)
		S.activate(collection, "field")
		assert(
			collection.Status.Text == "Purchase pending" and #requests == 1,
			"Pending wins over local errors and duplicate buys"
		)
		state.purchase = ""
		state.owned.canvas = true
		S.update(collection, state)
		S.activate(collection, "canvas")
		assert(#requests == 2 and requests[2][1] == "equip", "Owned styles equip with zero Coins")
		state.owned.canvas = nil
		S.update(collection, state)
		S.activate(collection, "canvas")
		collection.Panel.Visible = false
		task.wait()
		collection.Panel.Visible = true
		S.update(collection, state)
		assert(collection.Status.Text == "", "Reopening does not restore stale errors")
		S.activate(collection, "canvas")
		task.wait(3.1)
		S.update(collection, state)
		assert(collection.Status.Text == "", "The simple message expires")
	end)
	S.destroy(collection)
	ui.Screen:Destroy()
	clone:Destroy()
	assert(ok, err)
	return 2
end
]]></ProtectedString>
