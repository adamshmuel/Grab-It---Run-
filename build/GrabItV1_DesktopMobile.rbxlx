			<Item class="ModuleScript" referent="RBX76a9bc24b12e4b5b9b979660672c185d">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
return function()
	local shared = game:GetService("ReplicatedStorage").GrabIt.Shared
	local features = shared:FindFirstChild("Presentation")
	assert(features, "RED: Presentation must exist for progression, item selection and HUD")
	local fresh = features:Clone()
	local View = require(fresh :: ModuleScript)
	fresh:Destroy()
	local function check(value, name)
		assert(value, name)
	end
	local items =
		{ { id = 1, x = -12, z = 12 }, { id = 2, x = 12, z = 12 }, { id = 3, x = -12, z = 18 } }
	check(View.nearest(items, {}, 1, -12, 3, 12) == 1, "nearest item")
	check(
		View.nearest(items, { [1] = true }, 1, -12, 3, 12) == nil,
		"collected items hidden, distance measured in 3D"
	)
	check(View.nearest(items, {}, 1, 0, 3, 12) == nil, "outside range")
	check(View.inDeposit(0, 3, -8) and not View.inDeposit(9, 3, -8), "deposit boundary")
	check(View.inWarehouse(0, 3, 1) and not View.inWarehouse(0, 3, -1), "warehouse boundary")
	assert(View.camera(Vector3.new(0, 4, -18)).LookVector.Z > 0, "initial camera faces warehouse")
	check(
		math.abs(
			(View.camera(Vector3.new(0, 4, -18)).Position - Vector3.new(0, 6, -18)).Magnitude - 14
		) < 0.001,
		"initial camera starts fourteen studs from its focus"
	)
	local stale = { ready = true, open = true, target = 2, roundId = 1, collected = {} }
	check(
		View.collectionTarget(items, stale, Vector3.new(12.074, 3.725, 18.065)) == nil,
		"stale server hint outside six studs is not actionable"
	)
	check(
		View.collectionTarget(items, stale, Vector3.new(12, 3.725, 16)) == 2,
		"nearby item uses current local position"
	)
	print("PASS targeting, camera and world boundaries")
	return 6
end
]]></ProtectedString>
					<string name="ScriptGuid">{0ae64d51-238e-467a-9bb7-d4b30e4adca6}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Features.spec</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">3484a6fc880101a50aeba11400000c99</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX9d84113e45fd440c9bcc95b924f5a883">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
return function(): number
	local shared = game:GetService("ReplicatedStorage").GrabIt.Shared:Clone()
	local R = require(shared.GameRules)
	local a, b = R.newPlayer(), R.newPlayer()
	assert(a.coins == 0 and #a.cargo == 0 and R.speed(a) == 16, "fresh player")
	assert(
		not R.collect(a, 1, 1, false, 0) and not R.collect(a, 1, 1, true, 6.01),
		"closed and distant rejected"
	)
	assert(R.collect(a, 1, 1, true, 6) and R.collect(b, 1, 1, true, 6), "personal copies")
	assert(not R.collect(a, 1, 1, true, 0), "duplicate rejected")
	assert(R.bank(a) == 2 and R.bank(a) == 0 and a.coins == 2, "bank exactly once")
	assert(R.collect(a, 2, 1, true, 0), "Gameplay.spec: R.collect(a, 2, 1, true, 0)")
	R.lose(a)
	assert(
		a.coins == 2 and not a.collected[2],
		"Gameplay.spec: a.coins == 2 and not a.collected[2]"
	)
	R.beginStage(a, 2, 2)
	assert(
		R.collect(a, 1, 2, true, 0) and R.bank(a) == 3 and a.coins == 5,
		"subsequent stage continues"
	)
	shared:Destroy()
	return 7
end
]]></ProtectedString>
