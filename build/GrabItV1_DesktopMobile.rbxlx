			</Item>
			<Item class="ModuleScript" referent="RBX6348bd81a6c34737afa4aaeb941876bc">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
return function(): number
	local module = game.ServerScriptService.GrabItModules.Visuals:Clone()
	local Visuals = require(module)
	local Catalog = require(game.ReplicatedStorage.GrabIt.Shared.Catalog)
	local holder = Instance.new("Folder")
	local ok, err = pcall(function()
		local drum = Visuals.createItem(Catalog.items(1)[13], holder, CFrame.identity)
		assert(
			math.abs(drum.Drum.CFrame.RightVector.Y) > 0.99,
			"Drum cylinder must stand upright rather than receive a second rotation"
		)
		local rim = drum.Rim
		assert(
			rim.Size.X < math.min(rim.Size.Y, rim.Size.Z),
			"Drum rim is a thin disc on its cylinder axis"
		)
		local camera = Visuals.createItem(Catalog.items(2)[7], holder, CFrame.identity)
		assert(
			camera.Lens:IsA("Part") and camera.Lens.Shape == Enum.PartType.Cylinder,
			"Lens geometry uses the native cylinder whose axis is verified below"
		)
		assert(
			math.abs(camera.Lens.CFrame.RightVector.Z) > 0.99,
			"Camera lens must face forward as a disc, not a vertical bar"
		)
		local speaker = Visuals.createItem(Catalog.items(2)[13], holder, CFrame.identity)
		assert(
			math.abs(speaker.Cone.CFrame.RightVector.Z) > 0.99,
			"Speaker cones must face forward"
		)
		local drone = Visuals.createItem(Catalog.items(2)[19], holder, CFrame.identity)
		local motors = 0
		for _, motor in drone:GetChildren() do
			if motor:IsA("BasePart") and motor.Name == "Motor" then
				motors += 1
				local blades = {}
				for _, blade in drone:GetChildren() do
					if blade:IsA("BasePart") and blade.Name == "Rotor" then
						local delta = blade.Position - motor.Position
						if Vector2.new(delta.X, delta.Z).Magnitude < 0.03 then
							table.insert(blades, blade)
						end
					end
				end
				assert(#blades == 2, "Each motor needs two crossing propeller blades")
				assert(
					math.abs(blades[1].CFrame.RightVector:Dot(blades[2].CFrame.RightVector)) < 0.05,
					"A propeller must have a cross silhouette rather than two parallel bars"
				)
				assert(
					blades[1].Size.X > motor.Size.Y * 2,
					"Propeller blades must visibly extend beyond their motor"
				)
			end
		end
		assert(motors == 4, "A quadcopter must have four powered rotor assemblies")
		local gems = Visuals.createItem(Catalog.items(3)[1], holder, CFrame.identity)
		for _, tip in gems:GetChildren() do
			if tip:IsA("WedgePart") and tip.Name == "CrystalTip" then
				local nearest = nil
				for _, body in gems:GetChildren() do
					if body:IsA("BasePart") and body.Name == "Crystal" then
						if
							not nearest
							or math.abs(body.Position.X - tip.Position.X)
								< math.abs(nearest.Position.X - tip.Position.X)
						then
							nearest = body
						end
					end
				end
				local peak =
					tip.CFrame:PointToWorldSpace(Vector3.new(0, tip.Size.Y / 2, tip.Size.Z / 2))
				assert(
					nearest and math.abs(peak.X - nearest.Position.X) < 0.02,
					"Crystal facets must meet at a central peak, not form a split V"
				)
			end
		end
	end)
	holder:Destroy()
	module:Destroy()
	assert(ok, err)
	return 1
end
]]></ProtectedString>
					<string name="ScriptGuid">{0455416d-bdc7-4dd6-a032-43985608bb6d}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CollectibleShapes.spec</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">757135cc0250e8ce0af0ee8f000009d4</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXc9ea254de2874a0b985f951445f31dbd">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
return function(): number
	local shared = game:GetService("ReplicatedStorage").GrabIt.Shared:Clone()
	local ok, result = pcall(function()
		local module = shared:FindFirstChild("LoadProgress")
		assert(module, "RED: delayed load needs a fail-closed deadline")
		local Loader = require(module)
		local now = 0
		local releases = 0
		local calls = 0
		local store = {
			load = function(_self, _key)
				calls += 1
				now = 16
				return {
					coins = 20,
					owned = { basic = true },
					selected = "basic",
					revision = 1,
					tutorial = true,
				}
			end,
			releaseProfile = function(_self, _key, data)
				releases += 1
				assert(data.coins == 20, "release loaded record unchanged")
				return true
			end,
		}
		local data, status = Loader.attempt(store, "player", 15, function()
			return now
		end)
		assert(
			data == nil and status == "expired" and releases == 1,
			"late load cannot silently unlock gameplay"
		)
		assert(Loader.attempt(store, "player", 15, function()
			return now
		end) == nil and calls == 1, "no new request after deadline")
		return 2
	end)
	shared:Destroy()
	assert(ok, result)
	return result
end
]]></ProtectedString>
					<string name="ScriptGuid">{87e87776-0d68-4c55-86f9-5ddeee3b8c28}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Loading.spec</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">757135cc0250e8ce0af0ee8f000009d6</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXf7e14428dba34c718c930735e6d0b105">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
return function(): number
	local source = game:GetService("ServerScriptService").GrabItModules
	local modules = source:Clone()
	local shared = game:GetService("ReplicatedStorage").GrabIt.Shared:Clone()
	local holder = Instance.new("Folder")
	local world: Model? = nil
	local ok, result = pcall(function()
		local V = require(modules.Visuals)
		local Catalog = require(shared.Catalog)
		for stage = 1, #Catalog.stages do
			for _, item in Catalog.items(stage) do
				local m = V.createItem(item, holder, CFrame.identity, 1)
				local _, size = m:GetBoundingBox()
				local expected = Vector3.new(table.unpack(item.size))
				assert(
					size.X <= expected.X + 0.01
						and size.Y <= expected.Y + 0.01
						and size.Z <= expected.Z + 0.01,
					"catalog envelope for " .. item.name
				)
				local carryScale = V.carryScale(item)
				local carried = V.createItem(item, holder, CFrame.identity, carryScale)
				local _, carriedSize = carried:GetBoundingBox()
				assert(
					(carriedSize - size * carryScale).Magnitude < 0.06,
					"Carried model preserves fitted proportions: " .. item.name
				)
				for index, part in carried:GetChildren() do
					if part:IsA("BasePart") then
						local original = m:GetChildren()[index]
						assert(
							original and (part.Size - original.Size * carryScale).Magnitude < 0.035,
							"Native minimum part size distorts carried detail: "
								.. item.name
								.. " / "
								.. part.Name
						)
					end
				end
				local colors = {}
				local parts = 0
				for _, v in m:GetDescendants() do
					if v:IsA("BasePart") then
						colors[tostring(v.Color)] = true
						parts += 1
						assert(not v.CanCollide, "ImprovementVisuals.spec: not v.CanCollide")
					end
				end
				local n = 0
				for _ in colors do
					n += 1
				end
				assert(
					n >= 3 and parts >= 3 and parts <= 64,
					"Model color roles and bounded part budget; not a visual-quality verdict"
				)
			end
		end
		local cameraItem = Catalog.items(2)[7]
		local wideItem = table.clone(cameraItem)
		wideItem.size = { cameraItem.size[1] * 2, cameraItem.size[2], cameraItem.size[3] }
		local normal = V.createItem(cameraItem, holder, CFrame.identity)
		local wide = V.createItem(wideItem, holder, CFrame.identity)
		assert(
			math.abs(normal.Body.Size.X / normal.Body.Size.Y - wide.Body.Size.X / wide.Body.Size.Y)
				< 0.001,
			"A wider allowed envelope must not stretch a camera body out of proportion"
		)
		local World = require(modules.World)
		world = World.build("GrabItDevelopmentFixture")
		World.setStage(world, 3)
		assert(
			#world.Items:GetChildren() == 31 and world:FindFirstChild("SpecialDisplay"),
			'ImprovementVisuals.spec: #world.Items:GetChildren() == 31 and world:FindFirstChild("SpecialDisplay")'
		)
		for _, v in world:GetDescendants() do
			assert(
				not string.find(v.Name, "Shelf"),
				'ImprovementVisuals.spec: not string.find(v.Name, "Shelf")'
			)
		end
		assert(
			world:FindFirstChild("LiveResults"),
			'ImprovementVisuals.spec: world:FindFirstChild("LiveResults")'
		)
		for stage = 4, 5 do
			local layout = Catalog.nextLayout(stage, Random.new(12))
			World.setStage(world, stage, layout)
			assert(
				#world.Items:GetChildren() == 31 and world.SpecialDisplay,
				"Late-stage special display"
			)
			assert(
				world:GetAttribute("LayoutVariant") == layout.variant
					and world:GetAttribute("LayoutFlips") == layout.flips,
				"World declares actual layout"
			)
			for _, item in Catalog.items(stage, layout) do
				assert(
					world.Items[tostring(item.id)]:FindFirstChild(item.name),
					"Native world uses actual randomized product"
				)
			end
		end
		World.setStage(world, 1)
		local posters = 0
		for _, entry in world.StageDecor:GetChildren() do
			if entry.Name == "ProductPoster" then
				posters += 1
				local frame, size = entry:GetBoundingBox()
				local wallDepth = math.abs(frame.RightVector.X) * size.X
					+ math.abs(frame.UpVector.X) * size.Y
					+ math.abs(frame.LookVector.X) * size.Z
				assert(wallDepth <= 0.121, "Product posters must stay flat against the side walls")
				assert(
					math.abs(frame.Position.X) + wallDepth / 2 <= 23.851,
					"Product posters must sit in front of the wall framing, not behind an upright"
				)
				assert(
					entry:FindFirstChild("Artwork"),
					"Posters need product artwork, not unrelated tiles"
				)
				for _, part in entry:GetDescendants() do
					if part:IsA("BasePart") then
						if part:IsA("Part") and part.Shape == Enum.PartType.Ball then
							assert(
								math.min(part.Size.X, part.Size.Y, part.Size.Z)
										/ math.max(part.Size.X, part.Size.Y, part.Size.Z)
									>= 0.2,
								"Flattened product spheres must retain a visible projected silhouette"
							)
						end
						assert(
							not part.CanCollide and not part.CanTouch and part.CanQuery,
							"Poster geometry must not obstruct players and must fade with the wall"
						)
					end
				end
			end
		end
		assert(posters == 6, "Each department needs three product posters on each side")

		assert(
			#world.Items:GetChildren() == 30 and not world:FindFirstChild("SpecialDisplay"),
			'ImprovementVisuals.spec: #world.Items:GetChildren() == 30 and not world:FindFirstChild("SpecialDisplay")'
		)
		return 4
	end)
	if world then
		world:Destroy()
	end
	holder:Destroy()
	shared:Destroy()
	modules:Destroy()
	assert(ok, result)
	return result
end
]]></ProtectedString>
